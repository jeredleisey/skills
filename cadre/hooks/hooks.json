{
  "description": "Guards for the one-way steps of git and GitHub: push and merge",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs", "push"],
            "if": "Bash(*git*)",
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs", "merge"],
            "if": "Bash(*gh*)",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/task-completed.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
